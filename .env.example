# Copy this file to ".env" and fill in your real values.
# .env is never committed to git / never shared — it's your local secrets file.

# --- MySQL connection ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_vaccination

# --- Flask session security ---
# Any random long string works. Example way to generate one:
#   python3 -c "import secrets; print(secrets.token_hex(16))"
SECRET_KEY=change-this-to-a-random-string

# --- AI Chatbot (optional) ---
# Get a key from https://console.anthropic.com
# If left blank, the chatbot still works using built-in offline answers.
ANTHROPIC_API_KEY=

# --- Email reminders (SMTP) ---
# Using Gmail? You CANNOT use your normal Gmail password here — Google
# requires an "App Password":
#   1. Turn on 2-Step Verification on your Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Generate a 16-character app password and paste it below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_NAME=SmartVax

# The base URL of your running app, used inside email buttons/links.
# Keep this as-is for local development.
APP_BASE_URL=http://localhost:5000
